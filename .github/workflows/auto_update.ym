name: Auto Update LPL

on:
  schedule:
    - cron: "0 8 * * *"   
    - cron: "0 9 * * *"   
    - cron: "30 9 * * *"  
    - cron: "0 13 * * *"
    - cron: "45 13 * * *"
    - cron: "0 14 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-links:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: Run filter script
        run: python filter.py

      - name: Commit and push changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add .
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto updated LPL playlist" && git push)
